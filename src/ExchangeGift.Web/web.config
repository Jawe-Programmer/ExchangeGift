<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration (SmarterASP.NET, Azure App Service on Windows, any IIS server).
  `dotnet publish` keeps this file and fills in the process path automatically.

  ADMIN PASSWORD: the site creates the "Administrator" account on its first start from the setting Admin__Password.
  Preferred: set Admin__Password in your host's control panel / Azure "Environment variables".
  Alternative: uncomment the Admin__Password line below, put your password in it, deploy, start the site once,
  then remove the line again. Never commit a real password to Git.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ExchangeGift.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- <environmentVariable name="Admin__Password" value="YOUR-PASSWORD-HERE" /> -->
          <!-- Optional: folder for the SQLite database and keys. Must be writable and NOT inside a public folder.
               Leave commented to use the app's own App_Data folder.
          <environmentVariable name="Storage__Directory" value="D:\home\data\exchangegift" />
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
