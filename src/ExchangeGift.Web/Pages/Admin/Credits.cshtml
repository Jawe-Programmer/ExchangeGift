        <dt>Email</dt><dd><a href="mailto:johnwayne.rebustes@gmail.com">johnwayne.rebustes@gmail.com</a></dd>
        <dt>Website</dt><dd><a href="https://johnwayne.is-a.dev" target="_blank" rel="noopener noreferrer">https://johnwayne.is-a.dev</a></dd>
