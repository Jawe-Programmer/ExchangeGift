        <text x="90" y="76" text-anchor="middle" font-family="Archivo, sans-serif" font-weight="800" font-size="17" fill="#ffe3d9">S</text>
        <circle cx="70" cy="76" r="3" fill="#ec3013"></circle><circle cx="74" cy="80" r="3" fill="#c4240c"></circle>
        <rect x="0" y="0" width="180" height="120" fill="url(#bury)"></rect>
        <path d="M-3 2 C 8 -6 20 -2 30 -5 C 44 -9 56 -3 70 -6 C 86 -9 100 -2 116 -6 C 132 -9 146 -3 160 -6 C 170 -8 178 -3 183 2 C 170 6 150 3 130 5 C 100 7 70 3 40 6 C 20 7 6 5 -3 2 Z" fill="#ffffff"></path>
      </svg>
    </div>
    <svg viewBox="0 0 300 140" preserveAspectRatio="none" style="position:absolute;left:-24%;bottom:-10%;width:148%;height:74%">
      <defs><linearGradient id="mound" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"></stop><stop offset=".7" stop-color="#e6ecf8"></stop><stop offset="1" stop-color="#c9d5ec"></stop></linearGradient></defs>
      <path d="M0 140 C 18 112 36 56 70 40 C 90 30 104 40 116 46 C 130 54 140 58 152 56 C 166 54 176 48 188 40 C 206 28 228 34 244 50 C 266 70 284 112 300 140 Z" fill="#dbe4f4"></path>
      <path d="M8 140 C 26 116 44 70 76 54 C 96 44 112 54 124 60 C 136 66 148 68 160 66 C 172 64 182 58 196 52 C 214 44 234 50 246 64 C 264 84 282 118 292 140 Z" fill="url(#mound)"></path>
      <ellipse cx="104" cy="60" rx="14" ry="6" fill="#ffffff"></ellipse><ellipse cx="200" cy="54" rx="16" ry="6" fill="#ffffff"></ellipse><ellipse cx="150" cy="70" rx="12" ry="4" fill="#f4f7fc"></ellipse>
      <path d="M48 76 C 62 60 78 50 96 48 M206 44 C 222 44 236 52 248 64" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round"></path>
      <path d="M110 96 C 140 104 170 102 196 92" stroke="#c6d2ea" stroke-width="2" fill="none" stroke-linecap="round" opacity=".7"></path>
      <ellipse cx="150" cy="138" rx="156" ry="8" fill="#f4f7fc"></ellipse>
      <circle cx="96" cy="86" r="1.6" fill="#fff"></circle><circle cx="160" cy="66" r="1.4" fill="#fff"></circle><circle cx="214" cy="84" r="1.8" fill="#fff"></circle>
    </svg>
    <span style="position:absolute;left:50%;bottom:10%;transform:translateX(-50%);display:flex;align-items:center;gap:8px;background:var(--color-text);color:#fff;font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:7px 12px;white-space:nowrap">
      <span style="width:8px;height:8px;background:var(--color-accent);animation:blink 1.2s ease-in-out infinite"></span>
      <span><x-t data-t="tapLabel"></x-t></span>
    </span>
  </button>

  <x-if data-if="open" hidden>
    <div data-on-click="backdropClick" style="position:absolute;inset:0;z-index:20;background:rgba(5,10,30,.66);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto">
      <div data-ref="cardRef" data-on-click="stop" style="width:min(460px,100%);margin:auto;background:var(--color-bg);color:var(--color-text);border:2px solid var(--color-text);box-shadow:var(--shadow-lg);animation:rise .55s cubic-bezier(.2,.9,.25,1.15) both">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 24px;background:var(--color-text);color:#fff;font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase">
          <span>Secret Santa <x-t data-t="year"></x-t></span><span style="color:#ffb3a6">For your eyes only</span>
        </div>
        <div style="position:relative;background:var(--color-accent);color:#fff;padding:32px 24px 28px;min-height:200px;display:flex;flex-direction:column;justify-content:flex-end;gap:14px;overflow:hidden">
          <div style="font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase">You are the Secret Santa of</div>
          <div style="font-family:var(--font-heading);font-weight:800;font-size:clamp(44px,12vw,76px);line-height:.9;letter-spacing:-.035em;text-wrap:balance"><x-t data-t="name"></x-t></div>
          <x-if data-if="showScratch" hidden>
            <canvas data-ref="scratchRef" data-on-pointerdown="scratchDown" data-on-pointermove="scratchMove" data-on-pointerup="scratchUp" data-on-pointercancel="scratchUp" data-on-pointerleave="scratchUp" style="position:absolute;inset:0;width:100%;height:100%;touch-action:none;cursor:grab;transition:opacity .7s ease;opacity:var(--b-scratchOpacity)"></canvas>
          </x-if>
        </div>
        <x-if data-if="notRevealed" hidden>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:16px 24px;border-top:2px solid var(--color-text)">
            <span style="display:flex;align-items:center;gap:10px;font-size:15px;font-weight:500">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 11V6a2 2 0 0 0-4 0v0"></path><path d="M14 10V4a2 2 0 0 0-4 0v2"></path><path d="M10 10.5V6a2 2 0 0 0-4 0v8"></path><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path></svg>
              Brush the snow off the card
            </span>
            <button data-on-click="clearAll" style="background:transparent;border:2px solid var(--color-text);padding:8px 12px;font-family:var(--font-body);font-weight:700;font-size:13px;color:var(--color-text);cursor:pointer;text-align:left" class="hv3">Clear it for me</button>
          </div>
        </x-if>
        <x-if data-if="revealed" hidden>
          <div style="display:flex;flex-direction:column;animation:fadeUp .6s .3s ease both">
            <div data-ref="wishBox" hidden>
              <div style="display:flex;justify-content:space-between;gap:12px;padding:14px 24px;border-top:2px solid var(--color-text);border-bottom:2px solid var(--color-text);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase">
                <span>Wishlist</span><span style="color:var(--color-accent-700)"><x-t data-t="wishCount"></x-t></span>
              </div>
              <div data-ref="wishRows"></div>
            </div>
            <div style="padding:20px 24px 24px">
              <button data-on-click="close" style="display:flex;justify-content:space-between;align-items:center;width:100%;background:var(--color-text);color:#fff;border:0;padding:15px 18px;font-family:var(--font-body);font-weight:700;font-size:15px;cursor:pointer;text-align:left" class="hv4">
                <span>Back to the snow</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </button>
            </div>
          </div>
        </x-if>
      </div>
    </div>
  </x-if>

  <canvas data-ref="fxRef" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:30"></canvas>
  <audio data-ref="audioRef" src="@Url.Content("~/themes/default-secret-santa-reveal/music.mp3")" loop preload="none"></audio>
</div>
