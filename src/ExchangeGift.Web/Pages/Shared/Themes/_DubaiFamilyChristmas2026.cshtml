        <div style="width:2px;height:76%;transform-origin:50% 100%;background:linear-gradient(0deg,rgba(255,248,235,.95),rgba(255,248,235,.5) 60%,rgba(255,248,235,0));box-shadow:0 0 6px rgba(255,248,235,.6);animation:jet 3.2s ease-in-out 0.69s infinite"></div>
