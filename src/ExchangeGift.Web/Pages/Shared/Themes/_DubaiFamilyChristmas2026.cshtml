        </defs>
        <use href="#bkShape" fill="url(#bkSide)"></use>
        <use href="#bkShape" fill="url(#bkWin)" opacity=".55"></use>
        <use href="#bkShape" fill="url(#bkGlow)"></use>
        <g clip-path="url(#bkClip)">
          <rect data-ref="litRef" x="0" y="1000" width="200" height="0" fill="url(#bkLit)" opacity=".85"></rect>
          <rect data-ref="litWinRef" x="0" y="1000" width="200" height="0" fill="url(#bkWinLit)"></rect>
        </g>
        <g stroke="#F3DCA0" stroke-width="1" opacity=".7">
          <line x1="95" y1="250" x2="105" y2="250"></line><line x1="88" y1="410" x2="112" y2="410"></line><line x1="79" y1="570" x2="121" y2="570"></line><line x1="67" y1="710" x2="133" y2="710"></line><line x1="53" y1="850" x2="147" y2="850"></line>
        </g>
      </svg>
      <div data-ref="starRef" style="position:absolute;left:50%;top:-14px;width:28px;height:28px;margin-left:-14px;animation:twinkle 3.2s ease-in-out infinite">
        <svg viewBox="0 0 28 28" width="28" height="28"><path d="M14 0 L15.6 12.4 L28 14 L15.6 15.6 L14 28 L12.4 15.6 L0 14 L12.4 12.4 Z" fill="#FFF8EB"></path><circle cx="14" cy="14" r="5" fill="#F3DCA0" opacity=".6"></circle></svg>
      </div>
