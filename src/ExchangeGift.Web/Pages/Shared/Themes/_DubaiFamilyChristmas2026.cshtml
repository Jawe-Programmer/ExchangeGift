  <div data-ref="santaRef" aria-hidden="true" style="position:fixed;left:0;top:0;z-index:1;width:clamp(190px, 27vw, 360px);aspect-ratio:420/92;pointer-events:none;opacity:0;will-change:transform;filter:drop-shadow(0 0 10px rgba(243,220,160,.45)) drop-shadow(0 2px 2px rgba(7,20,38,.6))">
    <svg viewBox="0 -6 420 98" width="100%" height="100%" style="display:block;overflow:visible">
      <defs>
        <linearGradient id="rdG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3DCA0"></stop><stop offset=".6" stop-color="#D8B777"></stop><stop offset="1" stop-color="#a7843f"></stop></linearGradient>
        <linearGradient id="slG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFF1C6"></stop><stop offset=".45" stop-color="#D8B777"></stop><stop offset="1" stop-color="#8a6c30"></stop></linearGradient>
        <path id="rdA" d="M12,20 C14,15 22,14 34,14 C42,14 47,13 50,10 L54,4 C55,2 57,2 58,3 L62,6 C64,7 64,9 62,10 L57,11 C55,15 53,19 52,22 C52,26 50,28 47,29 L60,35 L64,39 L61,40 L45,32 L30,30 L19,34 L5,40 L2,38 L15,30 C12,28 11,25 12,20 Z M12,19 L7,15 L11,22 Z"></path>
        <path id="rdB" d="M12,20 C14,15 22,14 34,14 C42,14 47,13 50,10 L54,4 C55,2 57,2 58,3 L62,6 C64,7 64,9 62,10 L57,11 C55,15 53,19 52,22 C52,26 50,28 47,29 L54,33 L50,39 L47.5,38 L50,33.5 L42,31 L30,30 L24,36 L29,40 L26,41.5 L20,36 L17,30 C12,28 11,25 12,20 Z M12,19 L7,15 L11,22 Z"></path>
        <path id="rdAnt" fill="none" stroke="#F3DCA0" stroke-width="1.3" stroke-linecap="round" d="M55,4 L52,-3 M53,0 L49,-2 M52.5,-1.5 L54,-6 M57.5,3 L59,-4 M58.5,-1 L62,-3.5 M58.8,-2.5 L57,-7"></path>
      </defs>
