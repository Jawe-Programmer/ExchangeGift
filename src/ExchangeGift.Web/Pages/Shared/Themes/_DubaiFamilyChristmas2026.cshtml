          <linearGradient id="frG" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a7843f"></stop><stop offset=".5" stop-color="#F3DCA0"></stop><stop offset="1" stop-color="#8a6c30"></stop></linearGradient>
          <pattern id="frLat" width="4" height="4" patternUnits="userSpaceOnUse"><path d="M0 0 L4 4 M4 0 L0 4" stroke="#5a4418" stroke-width=".5" opacity=".7"></path></pattern>
