          <rect x="660" y="130" width="50" height="170"></rect><rect x="720" y="150" width="60" height="150"></rect><rect x="790" y="85" width="40" height="215"></rect><rect x="835" y="140" width="40" height="160"></rect>
          <path d="M880,300 L880,100 Q905,58 932,86 L932,300 Z"></path>
          <rect x="1120" y="100" width="50" height="200"></rect><rect x="1175" y="60" width="40" height="240"></rect><rect x="1220" y="130" width="70" height="170"></rect><rect x="1295" y="90" width="35" height="210"></rect><rect x="1335" y="150" width="55" height="150"></rect><rect x="1392" y="110" width="48" height="190"></rect>
