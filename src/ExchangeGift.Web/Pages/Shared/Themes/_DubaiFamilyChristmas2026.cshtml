    <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" style="position:absolute;left:0;right:0;bottom:clamp(56px, 10vh, 110px);width:100%;height:clamp(150px, 26vh, 300px);display:block">
      <defs>
