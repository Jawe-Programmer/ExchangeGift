@model ExchangeGift.Web.Pages.ThemeViewModel
<div data-theme-root data-reveal-url="@Model.RevealUrl" data-preview="@(Model.IsPreview ? "1" : "0")" data-token="@Model.RequestToken" data-group-title="@Model.GroupTitle" data-participant-name="@Model.ParticipantName" data-year="@Model.Year" data-eyebrow="@Model.Eyebrow" style="position:relative;min-height:100svh;overflow-x:clip;font-family:'Jost',sans-serif;background:#071426">

  <div aria-hidden="true" style="position:fixed;inset:0;z-index:0;overflow:hidden;background:linear-gradient(180deg,#071426 0%,#0B1F3A 48%,#153858 82%,#0B1F3A 100%)">
    <div data-ref="hazeRef" style="position:absolute;left:calc(50% + clamp(96px, 25vw, 420px));bottom:clamp(56px, 10vh, 110px);width:min(120vw,1100px);height:60vh;transform:translate(-50%,30%);opacity:.6;background:radial-gradient(closest-side,rgba(216,183,119,.3),rgba(216,183,119,.08) 55%,rgba(216,183,119,0))"></div>
    <div style="position:absolute;left:0;right:0;bottom:clamp(56px, 10vh, 110px);height:34vh;background:linear-gradient(0deg,rgba(243,220,160,.10),rgba(21,56,88,0))"></div>

    <div data-ref="towerRef" style="position:absolute;left:calc(50% + clamp(96px, 25vw, 420px));bottom:clamp(56px, 10vh, 110px);height:clamp(440px, 84vh, 980px);aspect-ratio:200/1000;transform:translateX(-50%);filter:drop-shadow(0 0 28px rgba(216,183,119,.28))">
      <svg viewBox="0 0 200 1000" width="100%" height="100%" preserveAspectRatio="xMidYMax meet" style="display:block;overflow:visible">
        <defs>
          <linearGradient id="bkSide" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#1c4467"></stop><stop offset=".46" stop-color="#2d5d84"></stop><stop offset=".5" stop-color="#F3DCA0" stop-opacity=".85"></stop><stop offset=".54" stop-color="#14365a"></stop><stop offset="1" stop-color="#0B1F3A"></stop>
          </linearGradient>
          <linearGradient id="bkGlow" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#F3DCA0" stop-opacity=".45"></stop><stop offset=".45" stop-color="#D8B777" stop-opacity=".12"></stop><stop offset="1" stop-color="#D8B777" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="bkLit" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#D8B777"></stop><stop offset=".48" stop-color="#FFF1C6"></stop><stop offset=".52" stop-color="#F3DCA0"></stop><stop offset="1" stop-color="#a7843f"></stop>
          </linearGradient>
          <pattern id="bkWin" width="6" height="9" patternUnits="userSpaceOnUse">
            <rect x="1" y="2" width="1.4" height="3" fill="#F3DCA0" opacity=".75"></rect><rect x="4" y="5" width="1.4" height="3" fill="#F3DCA0" opacity=".4"></rect>
          </pattern>
          <pattern id="bkWinLit" width="6" height="9" patternUnits="userSpaceOnUse">
            <rect x="1" y="2" width="1.4" height="3" fill="#FFF8EB"></rect><rect x="4" y="5" width="1.4" height="3" fill="#FFF8EB" opacity=".8"></rect>
          </pattern>
          <path id="bkShape" d="M99,0 L101,0 L103,170 L105,170 L105,250 L108,250 L108,330 L112,330 L112,410 L116,410 L116,490 L121,490 L121,570 L127,570 L127,640 L133,640 L133,710 L140,710 L140,780 L147,780 L147,850 L155,850 L155,920 L162,920 L162,1000 L38,1000 L38,920 L45,920 L45,850 L53,850 L53,780 L60,780 L60,710 L67,710 L67,640 L73,640 L73,570 L79,570 L79,490 L84,490 L84,410 L88,410 L88,330 L92,330 L92,250 L95,250 L95,170 L97,170 Z"></path>
