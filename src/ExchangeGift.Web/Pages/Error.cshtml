@page
@model ErrorModel
@{
    ViewData["Title"] = "Link not available";
}
<span class="mark" aria-hidden="true"></span>
@if (Model.Code == 404)
{
    <h1>This link isn't available</h1>
    <p>Please check that you opened the exact link you were sent, or ask the organiser to send it again.</p>
}
else if (Model.Code == 429)
{
    <h1>Too many tries</h1>
    <p>Please wait a minute and try again.</p>
}
else
{
    <h1>Something went wrong</h1>
    <p>Please try again in a moment.</p>
}
