<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExchangeGift.Web</RootNamespace>
    <UserSecretsId>exchangegift-2-0-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- web.config is NOT deployed by default, so settings edited on the host (e.g. Admin__Password,
       Storage__Directory) survive later publishes. For the very first publish (or to push a new web.config on
       purpose) set the property: dotnet publish -p:DeployWebConfig=true
       (in Visual Studio: Publish > Show all settings, or add <DeployWebConfig>true</DeployWebConfig> temporarily). -->
  <PropertyGroup Condition="'$(DeployWebConfig)' != 'true'">
    <ExcludeFilesFromDeployment>$(ExcludeFilesFromDeployment);web.config</ExcludeFilesFromDeployment>
  </PropertyGroup>

</Project>
